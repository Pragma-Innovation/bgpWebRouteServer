# ==============================================================================
# Gabu — Developer Environment Configuration (.env.example)
# Copy to .env if you want to customize local development defaults:
#   cp .env.example .env && make dev-up
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=dev-secret-key-for-local-docker-compose-testing
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Database
POSTGRES_DB=bgpweb
POSTGRES_USER=bgpuser
POSTGRES_PASSWORD=bgppassword
DATABASE_URL=postgres://bgpuser:bgppassword@db:5432/bgpweb

# Automatic Bootstrapping & Seeding
AUTO_SEED_ROUTING=True
AUTO_SEED_DEMO_LAB=True

# Local BGP Speaker Defaults
BGP_LOCAL_AS=65000
BGP_ROUTER_ID=10.100.0.10
BGP_LISTEN_PORT=179

# BGP Engine Provider Configuration
BGP_ENGINE_BACKEND=apps.bgp_engine.backends.gobgp.GoBgpBackend
BGP_MOCK_MODE=False
GOBGP_GRPC_HOST=gobgp
GOBGP_GRPC_PORT=50051
GOBGP_TIMEOUT_SECONDS=10
PEER_SYNC_INTERVAL=10
