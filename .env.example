# ==============================================================================
# bgpWebRouteServer Environment Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-random-secret-key-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production/Docker, SQLite fallback in dev)
# Example PostgreSQL: postgres://bgpuser:bgppassword@localhost:5432/bgpweb
DATABASE_URL=postgres://bgpuser:bgppassword@db:5432/bgpweb

# CORS Settings (allow requests from Vue SPA dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# BGP Engine Provider Configuration
# Options:
#   apps.bgp_engine.backends.mock.MockBgpBackend
#   apps.bgp_engine.backends.gobgp.GoBgpBackend
BGP_ENGINE_BACKEND=apps.bgp_engine.backends.mock.MockBgpBackend
BGP_MOCK_MODE=True

# GoBGP Connection Settings (when using GoBgpBackend)
GOBGP_GRPC_HOST=gobgp
GOBGP_GRPC_PORT=50051
GOBGP_TIMEOUT_SECONDS=10
