# ==============================================================================
# Gabu — Production Environment Configuration (.env.prod.example)
# Quickstart:
#   1. cp .env.prod.example .env
#   2. Edit secrets, hostnames, initial Admin password, and Router ASN/ID below
#   3. make prod-up
# ==============================================================================

# --- 1. Security & Hostnames (REQUIRED: Change all secrets before deploying!) ---
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_64_CHAR_SECRET_KEY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gabu.example.com,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://gabu.example.com
# Set DJANGO_SECURE_COOKIES=True when running behind an HTTPS/TLS reverse proxy or Ingress
DJANGO_SECURE_COOKIES=False

# --- 2. PostgreSQL Database Credentials (REQUIRED: Change password!) ---
POSTGRES_DB=bgpweb
POSTGRES_USER=bgpuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# --- 3. Initial Administrator Account (Created automatically on first boot) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=noc@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- 4. Database Seeding Behavior ---
# Seeds starter RFC 7999 RTBH & Flowspec Pseudo-RIB profiles ONLY when database is empty
AUTO_SEED_ROUTING=True

# --- 5. Local BGP Speaker Identity (Initialized on first boot) ---
BGP_LOCAL_AS=65000
BGP_ROUTER_ID=192.0.2.10
BGP_LISTEN_PORT=179

# --- 6. Host Port Bindings & Runtime Tuning ---
# Web UI + API HTTP port exposed by unprivileged Nginx container (set to 80 if desired)
GABU_HTTP_PORT=8080
# BGP TCP port exposed by GoBGP container for backbone router peering
GABU_BGP_PORT=179
GUNICORN_WORKERS=3
PEER_SYNC_INTERVAL=10
